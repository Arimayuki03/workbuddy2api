/login.exe
/credit.exe
/wb2api.exe
/signin.exe

# Runtime logs & distribution archive（本地定制）
logs/
workbuddy2api-dist.zip

# Session artifacts
.omo/
.v2c/

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

